import tkinter as tk
from tkinter import messagebox
import sqlite3


# =========================
# Banco de Dados
# =========================

def conectar_banco():
    conexao = sqlite3.connect("clientes.db")
    cursor = conexao.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS clientes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nome TEXT NOT NULL,
            email TEXT NOT NULL,
            telefone TEXT NOT NULL
        )
    """)

    conexao.commit()
    return conexao


# =========================
# Função para salvar cliente
# =========================

def salvar_cliente():
    nome = entrada_nome.get().strip()
    email = entrada_email.get().strip()
    telefone = entrada_telefone.get().strip()

    # Validação dos campos
    if not nome or not email or not telefone:
        messagebox.showwarning(
            "Atenção",
            "Todos os campos devem ser preenchidos."
        )
        return

    try:
        conexao = conectar_banco()
        cursor = conexao.cursor()

        cursor.execute("""
            INSERT INTO clientes (nome, email, telefone)
            VALUES (?, ?, ?)
        """, (nome, email, telefone))

        conexao.commit()
        conexao.close()

        messagebox.showinfo(
            "Sucesso",
            "Cliente cadastrado com sucesso!"
        )

        limpar_formulario()

    except sqlite3.Error as erro:
        messagebox.showerror(
            "Erro",
            f"Não foi possível salvar o cliente.\nErro: {erro}"
        )


# =========================
# Função para limpar formulário
# =========================

def limpar_formulario():
    entrada_nome.delete(0, tk.END)
    entrada_email.delete(0, tk.END)
    entrada_telefone.delete(0, tk.END)

    entrada_nome.focus()


# =========================
# Função para visualizar clientes
# =========================

def visualizar_clientes():
    try:
        conexao = conectar_banco()
        cursor = conexao.cursor()

        cursor.execute("""
            SELECT id, nome, email, telefone
            FROM clientes
            ORDER BY id
        """)

        clientes = cursor.fetchall()
        conexao.close()

        # Criar nova janela
        janela_clientes = tk.Toplevel(janela)
        janela_clientes.title("Clientes Cadastrados")
        janela_clientes.geometry("650x400")
        janela_clientes.resizable(False, False)

        titulo = tk.Label(
            janela_clientes,
            text="Clientes Cadastrados",
            font=("Arial", 16, "bold")
        )
        titulo.pack(pady=15)

        # Área onde os clientes serão exibidos
        frame_lista = tk.Frame(janela_clientes)
        frame_lista.pack(padx=15, pady=10, fill="both", expand=True)

        # Cabeçalho
        tk.Label(
            frame_lista,
            text="ID",
            font=("Arial", 10, "bold"),
            width=5,
            relief="solid"
        ).grid(row=0, column=0)

        tk.Label(
            frame_lista,
            text="Nome",
            font=("Arial", 10, "bold"),
            width=25,
            relief="solid"
        ).grid(row=0, column=1)

        tk.Label(
            frame_lista,
            text="E-mail",
            font=("Arial", 10, "bold"),
            width=30,
            relief="solid"
        ).grid(row=0, column=2)

        tk.Label(
            frame_lista,
            text="Telefone",
            font=("Arial", 10, "bold"),
            width=18,
            relief="solid"
        ).grid(row=0, column=3)

        # Exibir os clientes
        if clientes:
            for linha, cliente in enumerate(clientes, start=1):
                tk.Label(
                    frame_lista,
                    text=cliente[0],
                    width=5,
                    relief="solid"
                ).grid(row=linha, column=0)

                tk.Label(
                    frame_lista,
                    text=cliente[1],
                    width=25,
                    relief="solid",
                    anchor="w"
                ).grid(row=linha, column=1)

                tk.Label(
                    frame_lista,
                    text=cliente[2],
                    width=30,
                    relief="solid",
                    anchor="w"
                ).grid(row=linha, column=2)

                tk.Label(
                    frame_lista,
                    text=cliente[3],
                    width=18,
                    relief="solid",
                    anchor="w"
                ).grid(row=linha, column=3)
        else:
            tk.Label(
                frame_lista,
                text="Nenhum cliente cadastrado.",
                font=("Arial", 11)
            ).grid(row=1, column=0, columnspan=4, pady=20)

        # Botão fechar
        botao_fechar = tk.Button(
            janela_clientes,
            text="Fechar",
            width=12,
            command=janela_clientes.destroy
        )
        botao_fechar.pack(pady=15)

    except sqlite3.Error as erro:
        messagebox.showerror(
            "Erro",
            f"Não foi possível visualizar os clientes.\nErro: {erro}"
        )


